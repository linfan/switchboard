#!/usr/bin/env node
// Deterministic fake interactive "claude" for PTY end-to-end tests. It runs as
// an ordinary terminal program (the v2 contract): print a banner on startup,
// then echo each submitted line back as `reply:<line>`. There is no stream-json
// — the pseudo-terminal is the entire integration surface.
import readline from "node:readline";

process.stdout.write("AGENT-READY\r\n");

const rl = readline.createInterface({ input: process.stdin });
let ticker = null;
let tui = false;
rl.on("line", (line) => {
  const t = line.trim();
  if (t === "") return;
  if (t === "quit") {
    if (tui) process.stdout.write("\x1b[?6l\x1b[r\x1b[?1049l");
    process.exit(0);
  }
  // `tick:<ms>:<count>` streams timed output, for scroll tests that need new
  // lines to arrive while the user is scrolled up.
  if (t.startsWith("tick:")) {
    const [ms, count] = t
      .slice(5)
      .split(":")
      .map((n) => parseInt(n, 10));
    if (ticker) clearInterval(ticker);
    let emitted = 0;
    ticker = setInterval(() => {
      process.stdout.write(`tick:${++emitted}\r\n`);
      if (ticker && emitted >= (count || 10)) {
        clearInterval(ticker);
        ticker = null;
      }
    }, ms || 1000);
    return;
  }
  if (t.startsWith("tui:")) {
    const [ms, count] = t
      .slice(4)
      .split(":")
      .map((n) => parseInt(n, 10));
    if (ticker) clearInterval(ticker);
    tui = true;
    let emitted = 0;
    process.stdout.write(
      "\x1b[?1049h\x1b[?6h\x1b[1;10r\x1b[1;1HHEADER\x1b[5;1HFRAME:0\x1b[10;1HFOOTER",
    );
    ticker = setInterval(() => {
      process.stdout.write(`\x1b[5;1HFRAME:${++emitted}\x1b[K`);
      if (ticker && emitted >= (count || 10)) {
        clearInterval(ticker);
        ticker = null;
      }
    }, ms || 1000);
    return;
  }
  process.stdout.write(`reply:${t}\r\n`);
});
rl.on("close", () => {
  if (ticker) clearInterval(ticker);
  if (tui) process.stdout.write("\x1b[?6l\x1b[r\x1b[?1049l");
  process.exit(0);
});
