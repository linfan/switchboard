# Rust
/target
**/target
Cargo.lock

# Stray ts-rs export dir (created if `cargo test -p switchboard-shared` runs
# without TS_RS_EXPORT_DIR; the Makefile sets it so bindings land in client/).
shared/bindings/

# Deploy artifacts (staged by `make deploy-server`)
/dist

# Node / client
node_modules
client/dist
client/.vite
client/src-tauri/target
client/src-tauri/gen

# Bare-size PNGs that render-icon.mjs emits on the way to icon.ico / icon.icns.
# Only the named variants fed from them are committed, and those all carry an
# `x` (32x32.png, 128x128@2x.png), so the negation keeps them tracked.
client/src-tauri/icons/[0-9]*.png
!client/src-tauri/icons/*x*.png

# Playwright (browser E2E) artifacts
client/test-results
client/playwright-report
client/tests-e2e/.server.json

# SQLite runtime data
*.db
*.db-shm
*.db-wal
/data
server/data

# Env / secrets
.env
.env.*
!.env.example

# OS / editor
.DS_Store
*.log
.idea
.vscode
note
